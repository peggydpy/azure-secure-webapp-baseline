{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "13144595401013598189"
    }
  },
  "parameters": {
    "appName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 12,
      "metadata": {
        "description": "Short, lowercase app prefix used in resource names (e.g. donorportal)."
      }
    },
    "environment": {
      "type": "string",
      "defaultValue": "dev",
      "allowedValues": [
        "dev",
        "prod"
      ],
      "metadata": {
        "description": "Deployment environment. Controls SKU sizes and protection settings."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "sqlEntraAdminLogin": {
      "type": "string",
      "metadata": {
        "description": "Display name / UPN of the Microsoft Entra user or group that administers Azure SQL."
      }
    },
    "sqlEntraAdminObjectId": {
      "type": "string",
      "metadata": {
        "description": "Object ID of that Microsoft Entra user or group."
      }
    },
    "sqlEntraAdminPrincipalType": {
      "type": "string",
      "defaultValue": "User",
      "allowedValues": [
        "User",
        "Group"
      ],
      "metadata": {
        "description": "Whether the SQL admin is a single user or a group (a group is recommended for teams)."
      }
    },
    "externalApiKey": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Optional third-party API key (e.g. payment processor). Stored only in Key Vault. Leave empty to skip."
      }
    },
    "secretExpiryDays": {
      "type": "int",
      "defaultValue": 365,
      "minValue": 30,
      "maxValue": 730,
      "metadata": {
        "description": "Days until the external API key secret expires (forces a rotation review)."
      }
    },
    "deploymentTime": {
      "type": "string",
      "defaultValue": "[utcNow('u')]",
      "metadata": {
        "description": "Do not set. Captures deployment time so secret expiry can be calculated."
      }
    },
    "enableDefenderForSql": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enable Microsoft Defender for SQL (adds monthly cost; recommended for prod)."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "project": "secure-webapp-baseline",
        "managedBy": "bicep"
      },
      "metadata": {
        "description": "Tags applied to every resource."
      }
    }
  },
  "variables": {
    "prefix": "[toLower(parameters('appName'))]",
    "suffix": "[uniqueString(resourceGroup().id)]",
    "allTags": "[union(parameters('tags'), createObject('environment', parameters('environment')))]",
    "logAnalyticsName": "[format('log-{0}-{1}', variables('prefix'), parameters('environment'))]",
    "appInsightsName": "[format('appi-{0}-{1}', variables('prefix'), parameters('environment'))]",
    "planName": "[format('plan-{0}-{1}', variables('prefix'), parameters('environment'))]",
    "webAppName": "[format('app-{0}-{1}-{2}', variables('prefix'), parameters('environment'), variables('suffix'))]",
    "sqlServerName": "[format('sql-{0}-{1}-{2}', variables('prefix'), parameters('environment'), variables('suffix'))]",
    "sqlDatabaseName": "appdb",
    "keyVaultName": "[take(format('kv-{0}-{1}-{2}', variables('prefix'), parameters('environment'), variables('suffix')), 24)]",
    "externalApiKeySecretName": "ExternalApiKey",
    "keyVaultSecretsUserRoleId": "4633458b-17de-408a-b874-0445c86b69e6",
    "sizing": {
      "dev": {
        "planSku": "B1",
        "sqlSku": "Basic",
        "sqlTier": "Basic",
        "logRetentionDays": 30,
        "alwaysOn": false,
        "purgeProtection": false
      },
      "prod": {
        "planSku": "P1v3",
        "sqlSku": "S1",
        "sqlTier": "Standard",
        "logRetentionDays": 90,
        "alwaysOn": true,
        "purgeProtection": true
      }
    },
    "size": "[variables('sizing')[parameters('environment')]]",
    "secretAppSettings": "[if(empty(parameters('externalApiKey')), createArray(), createArray(createObject('name', 'EXTERNAL_API_KEY', 'value', format('@Microsoft.KeyVault(VaultName={0};SecretName={1})', variables('keyVaultName'), variables('externalApiKeySecretName')))))]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2025-07-01",
      "name": "[variables('logAnalyticsName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('allTags')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": "[variables('size').logRetentionDays]"
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "tags": "[variables('allTags')]",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2025-01-01",
      "name": "[variables('sqlServerName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('allTags')]",
      "properties": {
        "minimalTlsVersion": "1.2",
        "publicNetworkAccess": "Enabled",
        "administrators": {
          "administratorType": "ActiveDirectory",
          "azureADOnlyAuthentication": true,
          "login": "[parameters('sqlEntraAdminLogin')]",
          "sid": "[parameters('sqlEntraAdminObjectId')]",
          "tenantId": "[tenant().tenantId]",
          "principalType": "[parameters('sqlEntraAdminPrincipalType')]"
        }
      }
    },
    {
      "type": "Microsoft.Sql/servers/firewallRules",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}/{1}', variables('sqlServerName'), 'AllowAzureServices')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}/{1}', variables('sqlServerName'), variables('sqlDatabaseName'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('allTags')]",
      "sku": {
        "name": "[variables('size').sqlSku]",
        "tier": "[variables('size').sqlTier]"
      },
      "properties": {
        "collation": "SQL_Latin1_General_CP1_CI_AS"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers/auditingSettings",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}/{1}', variables('sqlServerName'), 'default')]",
      "properties": {
        "state": "Enabled",
        "isAzureMonitorTargetEnabled": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "scope": "[resourceId('Microsoft.Sql/servers/databases', variables('sqlServerName'), 'master')]",
      "name": "sql-audit-to-log-analytics",
      "properties": {
        "workspaceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]",
        "logs": [
          {
            "category": "SQLSecurityAuditEvents",
            "enabled": true
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]",
        "[resourceId('Microsoft.Sql/servers/auditingSettings', variables('sqlServerName'), 'default')]",
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ]
    },
    {
      "condition": "[parameters('enableDefenderForSql')]",
      "type": "Microsoft.Sql/servers/securityAlertPolicies",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}/{1}', variables('sqlServerName'), 'Default')]",
      "properties": {
        "state": "Enabled"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2025-05-01",
      "name": "[variables('keyVaultName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('allTags')]",
      "properties": {
        "tenantId": "[tenant().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 90,
        "enablePurgeProtection": "[if(variables('size').purgeProtection, true(), null())]",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "condition": "[not(empty(parameters('externalApiKey')))]",
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2025-05-01",
      "name": "[format('{0}/{1}', variables('keyVaultName'), variables('externalApiKeySecretName'))]",
      "properties": {
        "value": "[parameters('externalApiKey')]",
        "contentType": "text/plain",
        "attributes": {
          "exp": "[dateTimeToEpoch(dateTimeAdd(parameters('deploymentTime'), format('P{0}D', parameters('secretExpiryDays'))))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
      "name": "kv-audit-to-log-analytics",
      "properties": {
        "workspaceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]",
        "logs": [
          {
            "category": "AuditEvent",
            "enabled": true
          }
        ],
        "metrics": [
          {
            "category": "AllMetrics",
            "enabled": true
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2024-11-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('allTags')]",
      "kind": "linux",
      "sku": {
        "name": "[variables('size').planSku]"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-11-01",
      "name": "[variables('webAppName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('allTags')]",
      "kind": "app,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "clientAffinityEnabled": false,
        "siteConfig": {
          "linuxFxVersion": "NODE|20-lts",
          "minTlsVersion": "1.2",
          "scmMinTlsVersion": "1.2",
          "ftpsState": "Disabled",
          "http20Enabled": true,
          "remoteDebuggingEnabled": false,
          "alwaysOn": "[variables('size').alwaysOn]",
          "healthCheckPath": "/",
          "appSettings": "[concat(createArray(createObject('name', 'APPLICATIONINSIGHTS_CONNECTION_STRING', 'value', reference(resourceId('Microsoft.Insights/components', variables('appInsightsName')), '2020-02-02').ConnectionString), createObject('name', 'SQL_CONNECTION_STRING', 'value', format('Server=tcp:{0},1433;Database={1};Authentication=Active Directory Managed Identity;Encrypt=True;TrustServerCertificate=False;', reference(resourceId('Microsoft.Sql/servers', variables('sqlServerName')), '2025-01-01').fullyQualifiedDomainName, variables('sqlDatabaseName'))), createObject('name', 'NODE_ENV', 'value', if(equals(parameters('environment'), 'prod'), 'production', 'development'))), variables('secretAppSettings'))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', variables('appInsightsName'))]",
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', variables('keyVaultName'), variables('externalApiKeySecretName'))]",
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
      "apiVersion": "2024-11-01",
      "name": "[format('{0}/{1}', variables('webAppName'), 'ftp')]",
      "properties": {
        "allow": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('webAppName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
      "apiVersion": "2024-11-01",
      "name": "[format('{0}/{1}', variables('webAppName'), 'scm')]",
      "properties": {
        "allow": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('webAppName'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "scope": "[resourceId('Microsoft.Web/sites', variables('webAppName'))]",
      "name": "app-logs-to-log-analytics",
      "properties": {
        "workspaceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]",
        "logs": [
          {
            "category": "AppServiceHTTPLogs",
            "enabled": true
          },
          {
            "category": "AppServiceConsoleLogs",
            "enabled": true
          },
          {
            "category": "AppServiceAuditLogs",
            "enabled": true
          }
        ],
        "metrics": [
          {
            "category": "AllMetrics",
            "enabled": true
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]",
        "[resourceId('Microsoft.Web/sites', variables('webAppName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), resourceId('Microsoft.Web/sites', variables('webAppName')), variables('keyVaultSecretsUserRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsUserRoleId'))]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('webAppName')), '2024-11-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
        "[resourceId('Microsoft.Web/sites', variables('webAppName'))]"
      ]
    }
  ],
  "outputs": {
    "webAppName": {
      "type": "string",
      "value": "[variables('webAppName')]"
    },
    "webAppUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', variables('webAppName')), '2024-11-01').defaultHostName)]"
    },
    "webAppPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', variables('webAppName')), '2024-11-01', 'full').identity.principalId]"
    },
    "sqlServerName": {
      "type": "string",
      "value": "[variables('sqlServerName')]"
    },
    "sqlServerFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Sql/servers', variables('sqlServerName')), '2025-01-01').fullyQualifiedDomainName]"
    },
    "sqlDatabaseName": {
      "type": "string",
      "value": "[variables('sqlDatabaseName')]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[variables('keyVaultName')]"
    },
    "logAnalyticsWorkspaceName": {
      "type": "string",
      "value": "[variables('logAnalyticsName')]"
    }
  }
}